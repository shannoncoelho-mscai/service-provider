{
  "name": "serviceconnect",
  "version": "0.1.0",
  "private": true,
  "description": "ServiceConnect — local service discovery and booking marketplace (college project)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "migrate": "npm run migrate --workspace server",
    "seed": "npm run seed --workspace server",
    "test": "npm test --workspace server && npm test --workspace client",
    "test:server": "npm test --workspace server",
    "test:client": "npm test --workspace client",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start:server": "npm run start --workspace server"
  },
  "engines": {
    "node": ">=20"
  }
}
