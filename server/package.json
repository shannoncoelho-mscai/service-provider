                         "dotenv":  "^16.4.7",
                         "express":  "^4.21.2",
                         "helmet":  "^8.0.0",
                         "jsonwebtoken":  "^9.0.2",
                         "multer":  "^2.4.0",
                         "pg":  "^8.13.1",
                         "zod":  "^3.24.1"
                     },
    "devDependencies":  {
                            "@types/cors":  "^2.8.17",
                            "@types/express":  "^4.17.21",
                            "@types/jsonwebtoken":  "^9.0.7",
                            "@types/multer":  "^2.3.0",
                            "@types/node":  "^22.10.5",
