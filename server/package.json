{
    "name":  "serviceconnect-server",
    "version":  "0.1.0",
    "private":  true,
    "description":  "ServiceConnect API â€” Node.js + Express + TypeScript",
    "main":  "dist/index.js",
    "scripts":  {
                    "dev":  "tsx watch src/index.ts",
                    "build":  "tsc -p tsconfig.json",
                    "start":  "node dist/index.js",
                    "typecheck":  "tsc --noEmit",
                    "migrate":  "tsx src/db/migrate.ts",
                    "seed":  "tsx src/db/seed.ts",
                    "test":  "tsx --test --test-concurrency=1 src/tests/auth.test.ts src/tests/provider.test.ts src/tests/services.test.ts src/tests/images.test.ts src/tests/service-images.test.ts src/tests/search.test.ts src/tests/profile.test.ts src/tests/bookings.test.ts src/tests/reviews.test.ts src/tests/notifications.test.ts src/tests/rolematrix.test.ts"
                },
    "dependencies":  {
