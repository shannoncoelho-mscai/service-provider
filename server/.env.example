# ServiceConnect server — copy to server/.env (git-ignored!)
#   copy server\.env.example server\.env        (Windows)
#   cp server/.env.example server/.env          (macOS/Linux)

NODE_ENV=development
PORT=4000

# Provided by docker-compose.yml at the repo root
DATABASE_URL=postgres://serviceconnect:serviceconnect_dev@localhost:5432/serviceconnect

# REQUIRED — at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_at_least_32_random_characters
JWT_EXPIRES_IN=1h

# Allowed browser origin (the Vite dev proxy makes this optional in development)
CORS_ORIGIN=http://localhost:5173
