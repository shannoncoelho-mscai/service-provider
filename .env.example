# ============================================================================
# ServiceConnect — environment variable reference (NO REAL SECRETS HERE)
# ============================================================================
# The operative files are:  server/.env  and  client/.env
# Copy the templates:
#   copy server\.env.example server\.env         (Windows)
#   cp server/.env.example server/.env           (macOS/Linux)
#
# Rules:
#   * Never commit .env files (they are git-ignored).
#   * Never hard-code secrets in source code.
#   * Generate a real JWT_SECRET:
#       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================

# ----------------------------------------------------------------------------
# Server (server/.env) — read by src/config/env.ts and validated with zod
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (docker-compose.yml provides a local dev DB)
DATABASE_URL=postgres://serviceconnect:serviceconnect_dev@localhost:5432/serviceconnect

# REQUIRED, minimum 32 characters. Replace before any real deployment.
JWT_SECRET=CHANGE_ME_generate_at_least_32_random_characters
JWT_EXPIRES_IN=1h

# Allowed browser origin (only needed because the Vite dev proxy is not used)
CORS_ORIGIN=http://localhost:5173

# ----------------------------------------------------------------------------
# Client (client/.env) — read by Vite at build/dev time
# ----------------------------------------------------------------------------
# Use "/api" to go through the Vite dev proxy (recommended in development).
# For a deployed frontend, point at the real API origin, e.g.
# https://api.serviceconnect.example.com/api
VITE_API_URL=/api
