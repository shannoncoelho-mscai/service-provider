# Client env — copy to client/.env (git-ignored)
#   copy client\.env.example client\.env        (Windows)
#   cp client/.env.example client/.env          (macOS/Linux)

# "/api" uses the Vite dev proxy (→ http://localhost:4000) in development.
# For deployed builds set the full API origin, e.g.
# https://api.serviceconnect.example.com/api
VITE_API_URL=/api
